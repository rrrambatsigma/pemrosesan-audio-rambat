# Salin file ini menjadi `.env` lalu isi nilainya.
# `.env` sudah masuk .gitignore — JANGAN pernah di-commit.

# Token Hugging Face (hf.co/settings/tokens -> New token -> Write)
# Nama HF_API_KEY dipakai kode lama; HF_TOKEN juga dikenali.
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Repo dataset tujuan. Dibuat otomatis saat scrape pertama.
# Private lebih aman untuk audio YouTube.
HF_DATASET_REPO=username/audio-sma-21-mapel-raw

# Opsional: upload lebih cepat (pip install hf_transfer)
# HF_HUB_ENABLE_HF_TRANSFER=1
